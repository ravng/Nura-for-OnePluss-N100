# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-oneplus-billie2-downstream
pkgdesc="OnePlus Nord N100 (Ubuntu Touch downstream kernel)"
pkgver=5
pkgrel=6
url="https://gitlab.com/ubports/porting/community-ports/android10/oneplus-nord-n100/oneplus-billie2"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-oneplus-billie2-downstream
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
"
makedepends="devicepkg-dev"
_adaptation_commit="3ed93c9d8bf0808cdce1d7d9ec5eb4536c26ff3d"
source="
	deviceinfo
	kernel-cmdline.conf
	udev-settle.conf
	udev-settle
	phoc.ini
	billie2-touch-resume
	billie2-touch-resume.initd
	billie2-touch-resume.ko
	bwrap-4.19
	greetd-config.toml
	libphosh-4.19.so
	phosh-billie2.desktop
	$pkgname-$_adaptation_commit.dtb::$url/-/raw/$_adaptation_commit/nord_n100.dtb
	$pkgname-$_adaptation_commit-dtbo.img::$url/-/raw/$_adaptation_commit/dtbo.img
"
subpackages="$pkgname-phosh"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/$pkgname-$_adaptation_commit.dtb" \
		"$pkgdir/boot/dtbs/nord_n100.dtb"
	install -Dm644 "$srcdir/$pkgname-$_adaptation_commit-dtbo.img" \
		"$pkgdir/boot/dtbo.img"
	install -Dm644 "$srcdir/udev-settle.conf" \
		"$pkgdir/etc/conf.d/udev-settle"
	install -Dm755 "$srcdir/udev-settle" \
		"$pkgdir/etc/init.d/udev-settle"
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	install="$subpkgname.post-install"
	install -Dm644 "$srcdir/phoc.ini" "$subpkgdir/etc/phosh/phoc.ini"
	install -Dm644 "$srcdir/greetd-config.toml" \
		"$subpkgdir/etc/phrog/greetd-config.toml"
	install -Dm644 "$srcdir/phosh-billie2.desktop" \
		"$subpkgdir/usr/local/share/wayland-sessions/phosh.desktop"
	# libappstream's asynchronous cache load crashes on this 4.19 kernel.
	install -Dm755 "$srcdir/libphosh-4.19.so" \
		"$subpkgdir/usr/lib/libphosh-0.45.so.0"
	install -Dm755 "$srcdir/bwrap-4.19" "$subpkgdir/usr/local/bin/bwrap"
	install -Dm644 "$srcdir/billie2-touch-resume.ko" \
		"$subpkgdir/lib/modules/4.19.95-perf+/extra/billie2-touch-resume.ko"
	install -Dm755 "$srcdir/billie2-touch-resume" \
		"$subpkgdir/usr/libexec/billie2-touch-resume"
	install -Dm755 "$srcdir/billie2-touch-resume.initd" \
		"$subpkgdir/etc/init.d/billie2-touch-resume"
	mkdir -p "$subpkgdir/etc/runlevels/default"
	ln -s /etc/init.d/billie2-touch-resume \
		"$subpkgdir/etc/runlevels/default/billie2-touch-resume"
}

