# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/nord_n100_defconfig

maintainer=""
pkgname=linux-oneplus-billie2-downstream
pkgver=4.19.95
pkgrel=1
pkgdesc="OnePlus Nord N100 Ubuntu Touch kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="oneplus-billie2-downstream"
url="https://gitlab.com/ubports/porting/community-ports/android10/oneplus-nord-n100/kernel-oneplus-sm4250"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	linux-headers
	openssl-dev
	perl
	xz
"

export CC="clang"
export HOSTCC="clang"

_repository="kernel-oneplus-sm4250"
_commit="4cc850f635a5764bae2bdd250137b79d736b4eb2"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::$url/-/archive/$_commit/$_repository-$_commit.tar.gz
	$_config::$url/-/raw/$_commit/arch/arm64/configs/nord_n100_defconfig
	remove-gcc-python-wrapper.patch
	Revert-selinux-Relocate-ss_initialized-and-selinux_e.patch
	fix-clang-implicit-function-types.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	KERNEL_IMAGE_NAME="Image.gz" downstreamkernel_package \
		"$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		INSTALL_MOD_PATH="$pkgdir" INSTALL_MOD_STRIP=1 \
		modules_install
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source
}

