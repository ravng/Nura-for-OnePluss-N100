# N100 local flash/checkpoint artifacts. GitHub rejects files over 100 MiB;
# keep reproducible metadata, source, checksums, and handoff documents in Git.
/archive/**/images/
/archive/**/wifi-artifacts/bin/
/archive/**/.git/
/archive/**/wifi-artifacts/source/**/*.o
/archive/**/wifi-artifacts/source/**/*.ko
/archive/**/wifi-artifacts/source/**/modules.order
/archive/**/wifi-artifacts/source/**/Module.symvers
/archive/**/wifi-artifacts/source/**/.tmp_versions/
/archive/**/wifi-artifacts/source/pd-mapper-src/
/archive/**/wifi-artifacts/source/qrtr-src/
/archive/**/wifi-artifacts/source/rmtfs-src/
/archive/**/wifi-artifacts/source/tqftpserv-src/

