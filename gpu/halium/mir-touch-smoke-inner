#!/bin/sh
set -eu

export EGL_PLATFORM=hwcomposer
export MIR_ANDROID_FORCE_HWC2=1
export XDG_RUNTIME_DIR=/run
probe_seconds=${1:-60}

server_log=/run/mir-touch-server.log
client_log=/run/mir-touch-client.log
rm -f /run/mir_socket /run/mir_socket_trusted /run/wayland-0 "$server_log" "$client_log"
server_pid=
client_pid=
trace_enabled=${MIR_INPUT_TRACE:-0}
trace_log=/run/mir-touch-strace.log

cleanup() {
    [ -z "$client_pid" ] || kill "$client_pid" 2>/dev/null || true
    if [ "$trace_enabled" -eq 1 ]; then
        pkill -TERM -x miral-kiosk 2>/dev/null || true
    fi
    [ -z "$server_pid" ] || kill "$server_pid" 2>/dev/null || true
    [ -z "$client_pid" ] || wait "$client_pid" 2>/dev/null || true
    [ -z "$server_pid" ] || wait "$server_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [ "$trace_enabled" -eq 1 ]; then
    rm -f "$trace_log"
    /usr/bin/strace -f -o "$trace_log" -e trace=openat,read,close,ioctl,fcntl \
        /usr/bin/miral-kiosk \
        --console-provider=vt \
        --vt=1 \
        --enable-input=true \
        --enable-touchspots \
        --file=/run/mir_socket \
        --disable-overlays=on \
        --input-report=log \
        --seat-report=log \
        --session-mediator-report=log \
        --on-fatal-error-except \
        >"$server_log" 2>&1 &
else
    /usr/bin/miral-kiosk \
        --console-provider=vt \
        --vt=1 \
        --enable-input=true \
        --enable-touchspots \
        --file=/run/mir_socket \
        --disable-overlays=on \
        --input-report=log \
        --seat-report=log \
        --session-mediator-report=log \
        --on-fatal-error-except \
        >"$server_log" 2>&1 &
fi
server_pid=$!

tries=0
while [ ! -S /run/wayland-0 ]; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
        cat "$server_log"
        echo "miral-kiosk exited before creating its Wayland socket" >&2
        exit 1
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 300 ]; then
        cat "$server_log"
        echo "Wayland socket was not created" >&2
        exit 1
    fi
    sleep 0.05
done
tries=0
while ! grep -F "evdev-input: Added /dev/input/event1" "$server_log" >/dev/null 2>&1; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
        cat "$server_log"
        echo "miral-kiosk exited before registering the touchscreen" >&2
        exit 1
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 800 ]; then
        cat "$server_log"
        echo "Mir did not register /dev/input/event1" >&2
        exit 1
    fi
    sleep 0.05
done


env -u EGL_PLATFORM \
    WAYLAND_DISPLAY=wayland-0 \
    XDG_RUNTIME_DIR=/run \
    /usr/bin/weston-simple-touch \
    >"$client_log" 2>&1 &
client_pid=$!

sleep 1
if ! kill -0 "$server_pid" 2>/dev/null || ! kill -0 "$client_pid" 2>/dev/null; then
    cat "$server_log"
    cat "$client_log"
    echo "Touch compositor or client exited during startup" >&2
    exit 1
fi

echo "TOUCH TEST READY: tap and drag on the display now"

remaining=$probe_seconds
while [ "$remaining" -gt 0 ]; do
    if ! kill -0 "$server_pid" 2>/dev/null || ! kill -0 "$client_pid" 2>/dev/null; then
        cat "$server_log"
        cat "$client_log"
        echo "Touch compositor or client exited during the probe" >&2
        exit 1
    fi
    sleep 1
    remaining=$((remaining - 1))
done

grep -F "GLRenderer: GL renderer: Adreno (TM) 610" "$server_log"
grep -F "evdev-input: Added /dev/input/event1" "$server_log"
if ! grep -F "type=EV_ABS" "$server_log"; then
    echo "FAIL: Mir registered event1 but received no touchscreen coordinates" >&2
    exit 1
fi

echo "PASS: Mir received touchscreen coordinates on the Adreno-backed display"
